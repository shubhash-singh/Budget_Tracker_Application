<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".AddDataFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="3dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            app:cardCornerRadius="12dp"
            android:layout_margin="10dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@color/white">
               <LinearLayout
                   android:layout_width="0dp"
                   android:layout_height="match_parent"
                   android:layout_weight="0.7"
                   android:orientation="vertical">
                   <TextView
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/welcome"
                       android:fontFamily="@font/poppins_medium"
                       android:textStyle="bold"
                       android:textColor="@color/black"
                       android:paddingVertical="5dp"
                       android:paddingHorizontal="10dp"
                       android:textSize="22sp"/>
                   <TextView
                       android:id="@+id/name_of_user"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:text="@string/shubhash_singh"
                       android:textStyle="bold"
                       android:textColor="@color/black"
                       android:fontFamily="@font/poppins_medium"
                       android:paddingVertical="5dp"
                       android:paddingHorizontal="10dp"
                       android:textSize="22sp"
                       />
               </LinearLayout>
                <com.airbnb.lottie.LottieAnimationView
                    android:layout_width="0dp"
                    android:layout_weight="0.3"
                    android:layout_height="90dp"
                    app:lottie_rawRes="@raw/money_with_card_animation"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="30dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/cardview_background_for_expense">

                <EditText
                    android:id="@+id/expenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/expense_amount"
                    android:fontFamily="@font/poppins_medium"
                    android:inputType="numberDecimal"
                    android:background="@drawable/custom_input_background"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#000000" />

                <EditText
                    android:id="@+id/expenseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/expense_description"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/custom_input_background"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#000000" />
                <Button
                    android:id="@+id/addExpenseButton"
                    android:layout_width="match_parent"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_height= "wrap_content"
                    android:text="@string/add_expense"
                    android:fontFamily="@font/poppins_medium"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:padding="2dp"
                    android:layout_marginVertical="7dp"
                    android:layout_marginHorizontal="25dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>



        <!-- Income Section -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            app:cardCornerRadius="12dp"
            android:layout_marginVertical="25dp"
            android:layout_marginHorizontal="10dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/cardview_background_for_expense">

                <EditText
                    android:id="@+id/incomeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/income_amount"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/custom_input_background"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#000000"
                    tools:ignore="TextContrastCheck" />




                <Button
                    android:id="@+id/addIncomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?android:attr/buttonBarButtonStyle"
                    android:text="@string/add_income"
                    android:fontFamily="@font/poppins_medium"
                    android:textStyle="bold"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:layout_marginVertical="7dp"
                    android:layout_marginHorizontal="25dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            app:cardCornerRadius="12dp"
            android:layout_marginVertical="25dp"
            android:layout_marginHorizontal="10dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="15dp"
                android:background="@color/white">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="15dp"
                    android:text="@string/remaining_balance"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    />

                <TextView
                    android:id="@+id/balanceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="15dp"
                    android:layout_marginHorizontal="5dp"
                    android:text="@string/empty_string"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#4CAF50"
                    android:textSize="18sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>